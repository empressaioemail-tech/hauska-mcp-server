{
  "name": "hauska-mcp-server",
  "version": "0.1.0",
  "description": "Hauska MCP Server. The verified ground truth layer for AI agents operating on physical space.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:docs": "tsx scripts/generate-tool-reference.ts && tsx scripts/build-docs.ts",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "gate-probe": "tsx scripts/gate-probe.ts",
    "migrate": "tsx scripts/migrate.ts",
    "test:inspector": "npx @modelcontextprotocol/inspector http://localhost:3000/mcp"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.14.0",
    "@hauska/atom-contract": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@upstash/redis": "^1.34.0",
    "express": "^4.21.0",
    "dotenv": "^16.4.5",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "marked": "^14.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
