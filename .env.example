# Port for the MCP server to listen on.
PORT=3000

# Environment label. Used in logs and responses.
HAUSKA_ENV=development

# How many proxy hops to trust when computing req.ip. Cloud Run is 1.
HAUSKA_TRUST_PROXY=1

# -----------------------------------------------------------------
# Backend (hauska-engine) connection.
# Stream 2A wires hauska-client.ts to this URL once Sync 3 lands.
# -----------------------------------------------------------------

HAUSKA_BACKEND_URL=http://localhost:4000
HAUSKA_BACKEND_API_KEY=replace-me

# -----------------------------------------------------------------
# Postgres for api_keys.
# Connection string. Provision via Cloud SQL in prod; local Postgres
# or docker in dev. Run `npm run migrate` to apply schema.
# -----------------------------------------------------------------

DATABASE_URL=postgres://hauska:hauska@localhost:5432/hauska_mcp
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------
# Upstash Redis (REST API) for rate limiting.
# Provision a free dev DB at https://console.upstash.com/ if needed.
# -----------------------------------------------------------------

UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# -----------------------------------------------------------------
# Admin bootstrap key. Required to call /admin/keys endpoints.
# Generate with: `openssl rand -base64 48`. Treat as a secret.
# -----------------------------------------------------------------

HAUSKA_ADMIN_BOOTSTRAP_KEY=

# -----------------------------------------------------------------
# Rate-limit caps per tier. 0 means unmetered on that axis.
# Defaults match doc_repo 29_mcp_surface_tier_model.md daily caps,
# with a per-minute burst cap derived from the daily figure.
# -----------------------------------------------------------------

# Free, unauthenticated (per-IP).
HAUSKA_FREE_IP_RPM=60
HAUSKA_FREE_IP_DAILY=1000

# Free, registered key.
HAUSKA_FREE_KEY_RPM=120
HAUSKA_FREE_KEY_DAILY=10000

# Developer Pro.
HAUSKA_DEVELOPER_PRO_RPM=600
HAUSKA_DEVELOPER_PRO_DAILY=50000

# Team.
HAUSKA_TEAM_RPM=3000
HAUSKA_TEAM_DAILY=500000

# Embedder License (unmetered by default).
HAUSKA_EMBEDDER_RPM=0
HAUSKA_EMBEDDER_DAILY=0

# -----------------------------------------------------------------
# Logging.
# v1 ships stdout JSON; Stream 2C upgrades to Postgres index + GCS payloads.
# -----------------------------------------------------------------

HAUSKA_LOG_DESTINATION=stdout
