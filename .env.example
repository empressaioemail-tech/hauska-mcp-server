# Port for the MCP server to listen on
PORT=3000

# URL of the existing Hauska atom query backend. The MCP server is a wrapper, not a duplicate.
# Replace with the real backend URL once available.
HAUSKA_BACKEND_URL=http://localhost:4000

# API key used by the MCP server to call the backend (if applicable).
# This is server-to-server auth, separate from end-user API keys.
HAUSKA_BACKEND_API_KEY=replace-me

# Comma-separated list of API keys that the MCP server accepts for paid-tier access.
# Free tier requests do not require a key. Set to empty string to disable paid tier.
HAUSKA_MCP_API_KEYS=

# Rate limit for free tier (requests per minute per IP).
HAUSKA_FREE_TIER_RPM=20

# Rate limit for paid tier (requests per minute per key).
HAUSKA_PAID_TIER_RPM=600

# Where to write query logs for training data capture.
# Options: "stdout" (for development), "file" (writes to ./logs/), or a connection string for a real store.
HAUSKA_LOG_DESTINATION=stdout

# Environment label. Used in logs and responses.
HAUSKA_ENV=development
