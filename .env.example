# Port for the MCP server to listen on.
PORT=3000

# Environment label. Used in logs and responses.
HAUSKA_ENV=development

# How many proxy hops to trust when computing req.ip. Cloud Run is 1.
HAUSKA_TRUST_PROXY=1

# -----------------------------------------------------------------
# Backend (hauska-engine) retrieval API connection.
# Stream 2A wired hauska-client.ts to these vars. Local dev defaults
# point at the hauska-engine retrieval-api running on :4000.
# -----------------------------------------------------------------

HAUSKA_BACKEND_URL=http://localhost:8080

# Bearer token for the retrieval API. Empty disables auth on the engine
# side (set on hauska-engine via RETRIEVAL_API_KEY; leave both empty in
# local dev). Required in staging/prod.
HAUSKA_ENGINE_API_KEY=

# -----------------------------------------------------------------
# Backend (legacy-design-tools) api-server connection.
# Codex (plan review) tools wrap this backend. Default points at the
# local legacy api-server on :5000. The legacy backend must grow a
# bearer-token middleware before these tools work end-to-end against a
# deployed instance; flagged for Lane C coordination in the
# 2026-05-19 Lane B session summary.
# -----------------------------------------------------------------

LEGACY_BACKEND_URL=http://localhost:5000

# Bearer token for the legacy backend. Empty disables the Authorization
# header. Required in staging/prod once the legacy backend grows
# service-token middleware.
LEGACY_BACKEND_API_KEY=

# Snapshot-secret for the Cortex /api/snapshots and /api/snapshots/:id/ifc
# routes. The legacy backend already accepts x-snapshot-secret on those
# specific routes (originally for the Revit add-in's service-to-service
# path). The MCP server uses this same secret for cortex_snapshot_register
# and cortex_ifc_ingest. Required in staging/prod.
LEGACY_SNAPSHOT_SECRET=

# -----------------------------------------------------------------
# Postgres for api_keys.
# Connection string. Provision via Cloud SQL in prod; local Postgres
# or docker in dev. Run `npm run migrate` to apply schema.
# -----------------------------------------------------------------

DATABASE_URL=postgres://hauska:hauska@localhost:5432/hauska_mcp
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------
# Upstash Redis (REST API) for rate limiting.
# Provision a free dev DB at https://console.upstash.com/ if needed.
# -----------------------------------------------------------------

UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# -----------------------------------------------------------------
# Admin bootstrap key. Required to call /admin/keys endpoints.
# Generate with: `openssl rand -base64 48`. Treat as a secret.
# -----------------------------------------------------------------

HAUSKA_ADMIN_BOOTSTRAP_KEY=

# -----------------------------------------------------------------
# Rate-limit caps per tier. 0 means unmetered on that axis.
# Defaults match doc_repo 29_mcp_surface_tier_model.md daily caps,
# with a per-minute burst cap derived from the daily figure.
# -----------------------------------------------------------------

# Free, unauthenticated (per-IP).
HAUSKA_FREE_IP_RPM=60
HAUSKA_FREE_IP_DAILY=1000

# Free, registered key.
HAUSKA_FREE_KEY_RPM=120
HAUSKA_FREE_KEY_DAILY=10000

# Developer Pro.
HAUSKA_DEVELOPER_PRO_RPM=600
HAUSKA_DEVELOPER_PRO_DAILY=50000

# Team.
HAUSKA_TEAM_RPM=3000
HAUSKA_TEAM_DAILY=500000

# Embedder License (unmetered by default).
HAUSKA_EMBEDDER_RPM=0
HAUSKA_EMBEDDER_DAILY=0

# -----------------------------------------------------------------
# Logging.
# v1 ships stdout JSON; Stream 2C upgrades to Postgres index + GCS payloads.
# -----------------------------------------------------------------

HAUSKA_LOG_DESTINATION=stdout

# -----------------------------------------------------------------
# GTM observation (76b sprint)
# -----------------------------------------------------------------

# Comma-separated api_keys.key_hash values for operator/internal traffic (E5).
HAUSKA_INTERNAL_KEY_HASHES=

# Forward tool_call events to cortex-api (cc-agent-C route).
GTM_MCP_EVENT_ENABLED=true
GTM_MCP_EVENT_API_KEY=
CORTEX_API_URL=

# Place MCP tools call brokerage place routes when true (after C track ships).
PLACE_API_ENABLED=false

# Coverage JSON for docs embed (GET /api/brokerage/v1/coverage).
COVERAGE_API_URL=https://api.hauska.dev/api/brokerage/v1/coverage
